{
    "name": "officeshare-chat-service",
    "version": "1.0.0",
    "description": "Real-time chat service for OfficeShare platform",
    "main": "src/server.js",
    "scripts": {
        "start": "node src/server.js",
        "dev": "nodemon src/server.js",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage"
    },
    "dependencies": {
        "express": "^4.18.2",
        "socket.io": "^4.7.2",
        "mongodb": "^5.7.0",
        "mongoose": "^7.4.0",
        "cors": "^2.8.5",
        "helmet": "^7.0.0",
        "express-rate-limit": "^6.8.1",
        "joi": "^17.9.2",
        "jsonwebtoken": "^9.0.1",
        "bcryptjs": "^2.4.3",
        "dotenv": "^16.3.1",
        "winston": "^3.10.0",
        "uuid": "^9.0.0"
    },
    "devDependencies": {
        "nodemon": "^3.0.1",
        "jest": "^29.6.1",
        "supertest": "^6.3.3",
        "socket.io-client": "^4.7.2"
    },
    "jest": {
        "testEnvironment": "node",
        "collectCoverageFrom": [
            "src/**/*.js",
            "!src/server.js"
        ],
        "coverageDirectory": "coverage",
        "coverageReporters": [
            "text",
            "lcov",
            "html"
        ]
    },
    "keywords": [
        "chat",
        "websocket",
        "real-time",
        "messaging",
        "officeshare"
    ],
    "author": "OfficeShare Team",
    "license": "MIT"
}